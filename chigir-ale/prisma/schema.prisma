// Prisma Schema for Chigir Ale
// Iteration 1: Identity, Organizations & Authorization
// Spec sections: 5-7, 52 (User/Org/Membership), 131

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH.JS (NextAuth v5) REQUIRED ADAPTER MODELS
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// DOMAIN: USER
// Spec section 52 (User model)
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  emailVerifiedAt    DateTime?  @map("email_verified_at")
  passwordHash       String?    @map("password_hash") @db.Text
  phone              String?
  phoneVerifiedAt    DateTime?  @map("phone_verified_at")
  avatarUrl          String?    @map("avatar_url")
  preferredLanguage  String     @default("en") @map("preferred_language")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  deletedAt          DateTime?  @map("deleted_at")

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Domain relations (expanded in later iterations)
  memberships Membership[]

  @@index([email])
  @@map("users")
}

// ============================================================
// DOMAIN: ORGANIZATION
// Spec section 52 (Organization model)
// ============================================================

enum OrganizationType {
  GOVERNMENT
  UTILITY
  MUNICIPALITY
  NGO
  PRIVATE
  PLATFORM
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  slug        String             @unique
  description String?
  type        OrganizationType
  status      OrganizationStatus @default(ACTIVE)
  logoUrl     String?            @map("logo_url")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  memberships Membership[]

  @@index([slug])
  @@map("organizations")
}

// ============================================================
// DOMAIN: MEMBERSHIP
// Spec section 52 (Membership model)
// Spec section 7.3 — Multi-Tenant Isolation
// ============================================================

enum MembershipRole {
  CITIZEN
  STAFF
  FIELD_WORKER
  DEPARTMENT_MANAGER
  ORG_ADMIN
  ANALYST
  PLATFORM_ADMIN
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
  REMOVED
}

model Membership {
  id             String           @id @default(uuid())
  userId         String           @map("user_id")
  organizationId String           @map("organization_id")
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}
