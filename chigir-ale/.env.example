# ==============================================================================
# Chigir Ale - Environment Configuration Template
# Spec: Section 104 (Environment Configuration) & Section 105 (Development Environments)
# ==============================================================================
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit sensitive production credentials or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL instance. Use connection pooling (e.g. PgBouncer) in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chigir_ale?schema=public"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Secret key for encrypting JWT sessions and tokens. Generate via `openssl rand -base64 32`.
AUTH_SECRET="your-development-auth-secret-min-32-chars-long"
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign upload tokens and direct download URLs
STORAGE_SECRET="your-storage-signing-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (S3-Compatible Evidence Storage)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_BUCKET="chigir-ale-evidence"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="placeholder-storage-access-key"
STORAGE_SECRET_KEY="placeholder-storage-secret-key"

# ------------------------------------------------------------------------------
# 4. MAPS & LOCATION INTELLIGENCE
# ------------------------------------------------------------------------------
# API key for reverse geocoding and vector tiles (e.g. Google Maps, Mapbox, or OSM)
MAP_API_KEY="placeholder-map-api-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="placeholder-google-maps-api-key"

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE & VOICE SERVICES
# ------------------------------------------------------------------------------
# API key for Gemini / external vision-language model for automated classification
AI_API_KEY="placeholder-ai-api-key"
AI_MODEL_NAME="gemini-2.0-flash"

# Speech-to-text API key for Amharic audio evidence transcription
VOICE_API_KEY="placeholder-voice-transcription-api-key"

# ------------------------------------------------------------------------------
# 6. NOTIFICATION CHANNELS (Push, Email, SMS)
# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM) / APNs configuration for push notifications
PUSH_CONFIG="placeholder-push-service-credentials-json"

# SMTP or transactional email provider (e.g. Resend, SendGrid, Amazon SES)
EMAIL_CONFIG="placeholder-smtp-credentials-or-api-key"
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="notifications@chigirale.et"

# SMS Gateway provider for offline mobile verification / citizen dispatch
SMS_GATEWAY_URL="https://api.example.com/sms/send"
SMS_API_KEY="placeholder-sms-api-key"

# ------------------------------------------------------------------------------
# 7. PERFORMANCE, CACHE & RATE LIMITING
# ------------------------------------------------------------------------------
# Redis connection URL for distributed rate limiting and response caching
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 8. MONITORING, TELEMETRY & WEBHOOKS
# ------------------------------------------------------------------------------
# Shared secret for signing outbound webhook payloads with HMAC-SHA256
WEBHOOK_SIGNING_SECRET="placeholder-webhook-signing-secret"
SENTRY_DSN=""
ENABLE_TELEMETRY="true"